{
  "name": "abilian-sbe-tailwind-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Tailwind CSS build for Abilian SBE Flask templates",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run copy-assets",
    "copy-assets": "mkdir -p ../src/abilian/sbe/static/vite && cp dist/*.css dist/*.js ../src/abilian/sbe/static/vite/",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/line-clamp": "^0.4.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.13",
    "alpinejs": "^3.15.0",
    "cross-env": "^7.0.3",
    "datatables.net": "^2.3.4",
    "jquery": "^3.7.1",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-each": "^1.1.0",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.0.1",
    "select2": "^4.1.0-rc.0",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.2"
  }
}
